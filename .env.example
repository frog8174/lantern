# 複製成 .env 後修改。模型挑選理由見 README「模型推薦」。

# ── A. 推薦：WSL2 裡的 vLLM 跑一顆 Qwen3.5-9B（4-bit），文字＋看圖＋OCR 全包 ──
#   適用 12GB 顯卡（例：RTX 3080 Ti）。啟動指令見 README。
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
# 填 vLLM 的 --served-model-name（或 curl http://localhost:8000/v1/models 回傳的 id）
LLM_MODEL=qwen3.5-9b
# 跟 vLLM 的 --max-model-len 一致。論文小於這個的 60% 就整篇送進 prompt，不用 RAG
LLM_CONTEXT_TOKENS=65536
# 關掉 Qwen 的 <think> 思考模式（回答快很多）。接不支援的外部 API 時程式會自動略過
DISABLE_THINKING=true

# 同時送給模型的請求上限（自動標註、對照翻譯會並行）。外部 API 常被限流（429）就調小到 1~2
LLM_CONCURRENCY=4

# ── 每個角色都可以接不同的 API：*_BASE_URL / *_API_KEY / *_MODEL，留空就沿用上一層 ──
#   VLM → 沿用 LLM；OCR → 沿用 VLM；EMBED → 沿用 LLM 的網址與 key

# 視覺模型（框選圖表 / 公式、圖表預覽的「請 AI 解釋」）。
# Qwen3.5 本身就能看圖，所以跟 LLM 用同一顆；留空也會沿用 LLM_MODEL
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=qwen3.5-9b

# ── B. 外部 API（品質優先，例：Qwen3.8-27B、GPT、DeepSeek 的 OpenAI 相容端點）──
# LLM_BASE_URL=https://<服務商的 OpenAI 相容網址>/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<服務商的模型名稱>
# LLM_CONTEXT_TOKENS=128000
# VLM_MODEL=<同上，要支援影像輸入>

# ── D. Claude 官方 API（Anthropic SDK）────────────────────────
#   取消下面的註解即可（.env 裡同一個名稱以最後一次出現的為準，會蓋過上面 A 的設定）。
#   Claude 本身能看圖，視覺、OCR 都用同一個模型。
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_CONTEXT_TOKENS=1000000
# LLM_EFFORT=medium
# VLM_MODEL=
#   各元件的推薦模型（理由見 README「各元件的模型」）；chat、summary、看圖沿用 LLM_MODEL
# LLM_MODEL_EXPLAIN=anthropic:claude-sonnet-5-5
# LLM_MODEL_TRANSLATE=anthropic:claude-haiku-5-5
# LLM_MODEL_HIGHLIGHT=anthropic:claude-sonnet-5-5
# LLM_MODEL_CITE=anthropic:claude-sonnet-5-5
# LLM_MODEL_OUTLINE=anthropic:claude-haiku-5-5
# LLM_MODEL_SUGGEST=anthropic:claude-haiku-5-5
# LLM_MODEL_ALIGN=anthropic:claude-haiku-5-5   （沒設就跟 LLM_MODEL_TRANSLATE 一樣）
# LLM_MODEL_WIKI=anthropic:claude-sonnet-5-5
# LLM_MODEL_NOTE=anthropic:claude-sonnet-5-5   （筆記分頁的「AI 擬初稿」）
# OCR_MODEL=anthropic:claude-sonnet-5-5

# ── C. 沒有模型，只想先開發前端 ─────────────────────────────
# LLM_MOCK=true

# OCR（只有匯入掃描版 PDF 時才會用到）。預設沿用上面的視覺模型。
# 想要更準可另開 PaddleOCR-VL-1.6（0.9B），並設 OCR_PROMPT=OCR:
OCR_ENABLED=true
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_PROMPT=

# Embedding 模型（語意檢索）。留空 = 用 BM25 關鍵字檢索。
# 64K context 下大多數論文直接整篇送，很少走到檢索，12GB 顯卡建議留空省顯存
# 例：vllm serve Qwen/Qwen3-Embedding-0.6B --port 8001（embedding 模式旗標依 vLLM 版本，見 vllm serve --help）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# 並排對照的逐句對應用 LaBSE 句向量（docs/labse.md）。留空 = 不做，選字時改問 LLM（慢 1~2 秒）
# 本機開發用對外網址 https://labse.toolmen.bime.ntu.edu.tw/v1；正式環境用叢集內位址（configmap）
ALIGN_EMBED_URL=
ALIGN_EMBED_MODEL=labse
# LaBSE 那邊的 VLLM_API_KEY
ALIGN_EMBED_API_KEY=

TARGET_LANG=繁體中文（台灣用語）
SEMANTIC_SCHOLAR_LOOKUP=true
# 選填：引用卡片、相關論文推薦用。沒 key 常被限流（429），免費申請 https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 登入。dev = 測試登入：選使用者、免密碼（cookie 未簽章，只能自己開發用）
AUTH_MODE=dev
# 啟動時建立的測試使用者（逗號分隔，user id = 名字）
TEST_USERS=alice,bob
# 看得到設定裡「API 用量」的人：email（oidc）或使用者 id（dev），逗號分隔；空白＝沒人看得到
ADMIN_USERS=

# ---- 登入（docs/auth.md）----
# AUTH_MODE=dev 選測試使用者（本機開發）；oidc＝Keycloak
# AUTH_MODE=oidc
# OIDC_ISSUER=https://<keycloak 網域>/realms/<realm>
# OIDC_CLIENT_ID=lantern-local
# OIDC_CLIENT_SECRET=        # Keycloak client 的 Credentials 分頁
# OIDC_DEV_CLIENT_ID=        # 本機開發用的 Keycloak client（redirect URI 要有 http://<本機>:7800/api/auth/callback）
# OIDC_DEV_SECRET=           # 那個 client 的 secret；兩個有設就優先於上面兩個（上線環境不要設）
# PUBLIC_BASE_URL=http://localhost:7800   # 組 redirect URI；部署時改成 https://<Lantern 網域>
# SESSION_SECRET=            # 隨機 ≥32 字元：python -c "import secrets;print(secrets.token_urlsafe(48))"
